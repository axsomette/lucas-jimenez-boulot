---
/**
 * Projects — registre des projets, filtrable Tous / Pro / Perso.
 * Le filtre est en CSS pur (boutons radio + :has()) : il marche sans JS et reste accessible au clavier.
 */
import { getCollection } from 'astro:content';
import ProjectRow from '@/components/ui/ProjectRow.astro';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => {
  // Projets featured en premier, puis par date décroissante
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return b.data.date.getTime() - a.data.date.getTime();
});

const proCount: number = sortedProjects.filter(p => p.data.type === 'pro').length;
const persoCount: number = sortedProjects.length - proCount;
---

<section id="projets" class="section" aria-labelledby="projets-title">
  <div class="container">
    <header class="section-head reveal">
      <p class="kicker">Réalisations</p>
      <h2 class="title" id="projets-title">Projets</h2>
      <p class="lead">
        Des sites institutionnels sous Drupal et des applications métier sur mesure.
        Chaque fiche indique la stack et renvoie au site quand il est en ligne.
      </p>
    </header>

    {sortedProjects.length > 0 ? (
      <div class="reg">
        <fieldset class="filter">
          <legend class="sr-only">Filtrer les projets</legend>
          <input type="radio" name="project-filter" id="pf-all" checked />
          <label for="pf-all">Tous <span>{sortedProjects.length}</span></label>
          <input type="radio" name="project-filter" id="pf-pro" />
          <label for="pf-pro">Pro <span>{proCount}</span></label>
          <input type="radio" name="project-filter" id="pf-perso" />
          <label for="pf-perso">Perso <span>{persoCount}</span></label>
        </fieldset>
        <p class="reg__count" aria-live="polite">
          <span class="c-all">{sortedProjects.length} projets</span>
          <span class="c-pro">{proCount} projets pro</span>
          <span class="c-perso">{persoCount} projets perso</span>
        </p>
        <ul class="reg__list">
          {sortedProjects.map(project => (
            <ProjectRow
              title={project.data.title}
              description={project.data.description}
              tags={project.data.tags}
              type={project.data.type}
              client={project.data.client}
              status={project.data.status}
              url={project.data.url}
              github={project.data.github}
            />
          ))}
        </ul>
      </div>
    ) : (
      <p class="lead" role="status">Les fiches projets arrivent bientôt.</p>
    )}
  </div>
</section>

<style>
  @layer components {
    .filter {
      display: inline-flex;
      flex-wrap: wrap;
      gap: 4px;
      padding: 4px;
      margin-bottom: 20px;
      border: 1px solid var(--color-line);
      border-radius: var(--radius-corner);
    }
    .filter input { position: absolute; width: 1px; height: 1px; opacity: 0; }
    .filter label {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 44px;
      padding: 0 16px;
      border-radius: var(--radius-corner-sm);
      font-size: 15px;
      font-weight: 600;
      color: var(--color-fog);
      cursor: pointer;
      transition: background-color .2s var(--ease-out), color .2s var(--ease-out);
    }
    .filter label span { font: 500 12px/1 var(--font-mono); color: var(--color-mist); }
    .filter label:hover { color: var(--color-bone); }
    .filter input:checked + label { background: var(--color-bone); color: var(--color-ink-0); }
    .filter input:checked + label span { color: #4A5170; }
    .filter input:focus-visible + label { outline: 2px solid var(--color-signal); outline-offset: 2px; }

    /* Les lignes viennent de ProjectRow : :global pour les atteindre depuis ce composant */
    .reg:has(#pf-pro:checked) :global(.row[data-type="perso"]),
    .reg:has(#pf-perso:checked) :global(.row[data-type="pro"]) { display: none; }

    .reg__count { margin-bottom: 10px; font: 500 12.5px/1 var(--font-mono); color: var(--color-mist); }
    .reg__count .c-pro,
    .reg__count .c-perso { display: none; }
    .reg:has(#pf-pro:checked) .c-all,
    .reg:has(#pf-perso:checked) .c-all { display: none; }
    .reg:has(#pf-pro:checked) .c-pro,
    .reg:has(#pf-perso:checked) .c-perso { display: inline; }

    .reg__list { border-top: 1px solid var(--color-line); }

    @container site (max-width: 379px) {
      .filter { display: flex; }
      .filter label { flex: 1 1 auto; justify-content: center; padding: 0 10px; }
    }
  }
</style>
