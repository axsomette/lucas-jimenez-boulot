---
/**
 * AiWorkflow — Développement assisté par IA.
 *
 * Section pensée pour l'entretien technique : elle ne liste pas des noms
 * d'assistants (ça, c'est la ligne « IA et productivité » de la stack), elle
 * montre l'outillage construit autour d'eux et les garde-fous qui le rendent
 * utilisable sur du code client.
 *
 * Chaque entrée porte un `role` explicite — « Conçu et développé » ou
 * « Intégré et orchestré ». La distinction est volontaire : revendiquer la
 * paternité d'un outil tiers est le genre de détail qui se vérifie en
 * entretien, et il vaut mieux que la nuance vienne de moi.
 */
interface Tool {
  name: string;
  role: 'built' | 'wired';
  desc: string;
  tags: string[];
}

interface Stat {
  valeur: string;
  label: string;
}

interface Step {
  name: string;
  /** Condition d'exécution affichée sous l'étape */
  gate?: string;
}

/** Chaîne d'exécution de drupal-expert, dans l'ordre réel de dispatch. */
const pipeline: Step[] = [
  { name: 'scanner' },
  { name: 'builder' },
  { name: 'code-reviewer' },
  { name: 'verifier' },
  { name: 'backup' },
  { name: 'applier', gate: 'après 3 feux verts' },
  { name: 'post-check' },
];

/** Portée réelle du déploiement, comptée sur le disque. */
const portee: Stat[] = [
  { valeur: '10', label: 'sous-agents' },
  { valeur: '10', label: 'skills' },
  { valeur: '11', label: 'projets équipés' },
  { valeur: '4',  label: 'runtimes' },
];

/** Les quatre formats d'agent sur lesquels la chaîne est portée. */
const runtimes: string[] = ['.claude', '.continue', '.cortex', '.agents'];

const guards: string[] = [
  'Sauvegarde datée avant chaque application',
  'Auto-correction en boucle si la revue échoue',
  'Diagnostic automatique en cas d’échec',
];

const tools: Tool[] = [
  {
    name: 'mamp-to-docker-db',
    role: 'built',
    desc: "Sort la base MySQL d'un projet Drupal de MAMP vers un conteneur Docker isolé, en laissant PHP sur l'hôte ou en le conteneurisant aussi. La skill détecte le port, la version MySQL et le nom de base, ou vous les demande, et ne code jamais rien en dur.",
    tags: ['Docker', 'MySQL', 'Drupal', 'Shell'],
  },
  {
    name: 'Mémoire persistante & hooks',
    role: 'wired',
    desc: "Serveur MCP branché sur le cycle de vie des sessions : je rappelle le contexte au démarrage et je l'écris avant compaction. PostgreSQL et les embeddings Ollama tournent en local, donc aucune ligne de code ne quitte la machine. Un garde-fou intercepte les lectures de fichiers et signale un contexte périmé.",
    tags: ['MCP', 'Hooks', 'PostgreSQL', 'Ollama'],
  },
  {
    name: 'Manuel opératoire versionné',
    role: 'built',
    desc: "Chaque projet porte son CLAUDE.md : conventions, commandes et pièges déjà rencontrés. J'y répète la même règle partout : aller vérifier dans le fichier avant d'affirmer quoi que ce soit sur le code.",
    tags: ['Documentation', 'Conventions', 'Onboarding'],
  },
];

const roleLabel: Record<Tool['role'], string> = {
  built: 'Conçu et développé',
  wired: 'Intégré et orchestré',
};
---

<section id="ia" class="section band" aria-labelledby="ia-title">
  <div class="container">
    <header class="section-head reveal">
      <p class="kicker">Workflow</p>
      <h2 class="title" id="ia-title">Développement assisté par IA</h2>
      <p class="lead">
        Sur du code client, une intervention assistée doit rester aussi vérifiable qu'une intervention manuelle.
        Je construis l'outillage qui l'impose : des sous-agents spécialisés et une double vérification avant toute écriture dans un projet.
      </p>
    </header>

    {/* ── Pièce maîtresse : la chaîne de sous-agents ── */}
    <article class="feature" aria-labelledby="dx-title">
      <div class="feature__head">
        <div>
          <h3 id="dx-title">drupal-expert</h3>
          <p>10 sous-agents et 10 skills, portés sur 4 runtimes</p>
        </div>
        <span class="role">{roleLabel.built}</span>
      </div>

      <div class="feature__text">
        <p>
          L'orchestrateur évalue le risque d'une demande Drupal, choisit le niveau d'autonomie, puis passe la main à des sous-agents dédiés.
          L'applier n'écrit dans le projet qu'après trois feux verts : sauvegarde créée, revue de code passée, configuration validée.
        </p>
        <p>
          J'ai porté la chaîne sur quatre runtimes d'agent et je l'ai installée sur onze projets Drupal de l'agence,
          qui l'utilisent avec la même séquence et les mêmes garde-fous.
        </p>
      </div>

      <ol class="pipe" aria-label="Étapes de la chaîne, dans l'ordre d'exécution">
        {pipeline.map((step, i) => (
          <li>
            <span class="pipe__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="pipe__lbl">
              <span class="pipe__name">{step.name}</span>
              {step.gate && <span class="pipe__gate">{step.gate}</span>}
            </span>
          </li>
        ))}
      </ol>

      <ul class="guards" aria-label="Garde-fous">
        {guards.map(g => (
          <li>
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 8.5 6.5 11.5 12.5 4.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
            {g}
          </li>
        ))}
      </ul>

      <dl class="stats" aria-label="Portée du déploiement">
        {portee.map(p => (
          <div>
            <dt>{p.label}</dt>
            <dd>{p.valeur}</dd>
          </div>
        ))}
      </dl>

      <div class="runtimes">
        <span>Formats d'agent</span>
        <ul class="tags" aria-label="Formats d'agent supportés">
          {runtimes.map(r => <li class="tag">{r}</li>)}
        </ul>
      </div>
    </article>

    {/* ── Le reste de l'outillage ── */}
    <div class="tools">
      {tools.map(tool => (
        <article class="tool" aria-labelledby={`tool-${tool.name.replace(/\W+/g, '-')}`}>
          <span class:list={['role', { 'role--wired': tool.role === 'wired' }]}>{roleLabel[tool.role]}</span>
          <h3 id={`tool-${tool.name.replace(/\W+/g, '-')}`}>{tool.name}</h3>
          <p>{tool.desc}</p>
          <ul class="tags" aria-label="Technologies">
            {tool.tags.map(tag => <li class="tag">{tag}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  @layer components {
    .feature {
      display: grid;
      gap: 28px;
      padding: clamp(22px, 4cqi, 44px);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-corner);
      background: var(--color-ink-0);
    }
    .feature__head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 20px; }
    .feature__head h3 { font: 750 clamp(26px, 3.6cqi, 40px)/1 var(--font-mono); letter-spacing: -.03em; }
    .feature__head p { margin-top: 8px; color: var(--color-fog); }
    .feature__text { display: grid; gap: 14px; max-width: 72ch; color: var(--color-fog); }

    /* Pipeline : vertical sur petit écran, horizontal dès 1180 px. L'étape active défile pour montrer l'ordre. */
    .pipe { position: relative; display: grid; }
    .pipe::before { content: ""; position: absolute; left: 15px; top: 16px; bottom: 16px; width: 2px; background: var(--color-line-strong); }
    .pipe li { position: relative; display: flex; align-items: center; gap: 14px; min-height: 48px; }
    .pipe__n {
      position: relative;
      z-index: 1;
      display: grid;
      place-items: center;
      flex: none;
      width: 32px;
      height: 32px;
      border: 1.5px solid var(--color-line-strong);
      border-radius: var(--radius-corner-sm);
      background: var(--color-ink-0);
      font: 600 11.5px/1 var(--font-mono);
      color: var(--color-fog);
      animation: pipe-step 6.3s var(--ease-out) infinite;
    }
    .pipe li:nth-child(2) .pipe__n { animation-delay: .9s; }
    .pipe li:nth-child(3) .pipe__n { animation-delay: 1.8s; }
    .pipe li:nth-child(4) .pipe__n { animation-delay: 2.7s; }
    .pipe li:nth-child(5) .pipe__n { animation-delay: 3.6s; }
    .pipe li:nth-child(6) .pipe__n { animation-delay: 4.5s; }
    .pipe li:nth-child(7) .pipe__n { animation-delay: 5.4s; }
    .pipe__lbl { display: grid; gap: 5px; }
    .pipe__name { font: 500 14.5px/1.2 var(--font-mono); }
    .pipe__gate { font: 500 11.5px/1.3 var(--font-mono); letter-spacing: .04em; color: var(--color-signal); }

    .guards { display: grid; gap: 10px; }
    .guards li { display: flex; align-items: flex-start; gap: 12px; font-size: 15.5px; }
    .guards svg { flex: none; width: 18px; height: 18px; margin-top: 3px; color: var(--color-ok); }

    .stats {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1px;
      overflow: hidden;
      border: 1px solid var(--color-line);
      border-radius: var(--radius-corner-sm);
      background: var(--color-line);
    }
    .stats > div { display: flex; flex-direction: column-reverse; gap: 6px; padding: 18px 20px; background: var(--color-ink-0); }
    .stats dd { font: 800 34px/1 var(--font-display); font-stretch: 112%; letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
    .stats dt { font: 500 12px/1.3 var(--font-mono); letter-spacing: .06em; color: var(--color-mist); }

    .runtimes { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; }
    .runtimes > span { font: 500 12px/1 var(--font-mono); color: var(--color-mist); }

    .tools { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 16px; margin-top: 16px; }
    .tool {
      display: grid;
      align-content: start;
      gap: 16px;
      padding: 26px;
      border: 1px solid var(--color-line);
      border-radius: var(--radius-corner);
      background: var(--color-ink-0);
    }
    .tool .role { justify-self: start; }
    .tool h3 { font: 650 18px/1.3 var(--font-body); }
    .tool p { font-size: 15.5px; color: var(--color-fog); }

    @container site (min-width: 600px) {
      .stats { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    }
    @container site (min-width: 960px) {
      .feature { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 56px; }
      .feature__head, .feature__text { grid-column: 1 / -1; }
      .pipe { grid-row: span 3; }
    }
    @container site (min-width: 1180px) {
      .pipe { grid-row: auto; grid-column: 1 / -1; grid-template-columns: repeat(7, minmax(0, 1fr)); padding-top: 4px; }
      .pipe::before { left: 16px; right: 16px; top: 15px; bottom: auto; width: auto; height: 2px; }
      .pipe li { flex-direction: column; align-items: flex-start; gap: 12px; min-height: 0; }
      .runtimes { grid-column: 1 / -1; }
    }
  }

  @keyframes pipe-step {
    0%, 12% { background: var(--color-signal); color: var(--color-signal-ink); border-color: var(--color-signal); }
    16%, 100% { background: var(--color-ink-0); color: var(--color-fog); border-color: var(--color-line-strong); }
  }
</style>
