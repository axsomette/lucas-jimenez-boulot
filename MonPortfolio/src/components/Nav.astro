---
/**
 * Nav — barre collante avec le logo.
 * Au-dessus de 1060 px de large : liens en ligne. En dessous : menu <details>,
 * qui reste utilisable sans JS ; le script ne fait que le refermer proprement.
 */
import { getCollection } from 'astro:content';
import Mark from './ui/Mark.astro';

interface NavLink {
  href: string;
  label: string;
  /** Repère discret affiché dans le menu mobile */
  hint?: string;
  /** Lien vers une autre page (pas une ancre de l'accueil) */
  page?: boolean;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projects = await getCollection('projects');
const posts = await getCollection('blog', ({ data }) => !data.draft);
const experiences = await getCollection('experiences');
const since: number = Math.min(...experiences.map(xp => xp.data.startDate.getFullYear()));
const onBlog: boolean = Astro.url.pathname.includes('/blog');

const navLinks: NavLink[] = [
  { href: `${base}/#projets`,  label: 'Projets',  hint: `${projects.length} fiches` },
  { href: `${base}/#parcours`, label: 'Parcours', hint: `depuis ${since}` },
  { href: `${base}/#apropos`,  label: 'À propos' },
  { href: `${base}/#ia`,       label: 'IA',       hint: 'outillage' },
  { href: `${base}/blog/`,     label: 'Blog',     hint: `${posts.length} articles`, page: true },
];
---

<header class="nav">
  <div class="container nav__in">
    <a href={`${base}/`} class="brand" aria-label="Lucas Jimenez Boulot, accueil">
      <Mark />
      <span class="brand__name">Lucas Jimenez Boulot</span>
    </a>

    <nav class="nav__links" aria-label="Navigation principale">
      <ul>
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              data-page={link.page ? 'true' : undefined}
              aria-current={link.page && onBlog ? 'page' : undefined}
            >{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a href={`${base}/#contact`} class="btn btn--line nav__cta">Me contacter</a>

    <details class="menu">
      <summary>
        <span class="menu__icon" aria-hidden="true"></span>
        <span class="menu__open">Menu</span>
        <span class="menu__close">Fermer</span>
      </summary>
      <nav class="menu__sheet" aria-label="Navigation mobile">
        <ul>
          {navLinks.map(link => (
            <li>
              <a href={link.href} aria-current={link.page && onBlog ? 'page' : undefined}>
                {link.label}
                {link.hint && <span>{link.hint}</span>}
              </a>
            </li>
          ))}
        </ul>
        <a href={`${base}/#contact`} class="btn btn--signal">Me contacter</a>
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.menu');
  const summary = menu?.querySelector<HTMLElement>('summary');

  // Une ancre de la même page ne recharge rien : on referme le menu à la main.
  menu?.querySelectorAll<HTMLAnchorElement>('.menu__sheet a').forEach(link => {
    link.addEventListener('click', () => { menu.open = false; });
  });

  document.addEventListener('keydown', (event: KeyboardEvent) => {
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false;
      summary?.focus();
    }
  });

  document.addEventListener('click', (event: MouseEvent) => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
  });

  // Lien actif : la section qui occupe le haut de l'écran
  const anchors = [...document.querySelectorAll<HTMLAnchorElement>('.nav__links a:not([data-page])')];
  const sections = document.querySelectorAll<HTMLElement>('main section[id]');
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      anchors.forEach(a => {
        const isCurrent = a.hash === `#${entry.target.id}`;
        if (isCurrent) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      });
    });
  }, { rootMargin: '-30% 0px -60% 0px' });
  sections.forEach(section => observer.observe(section));
</script>

<style>
  @layer components {
    .nav {
      position: sticky;
      top: 0;
      z-index: var(--z-nav);
      background: color-mix(in srgb, var(--color-ink-0) 88%, transparent);
      -webkit-backdrop-filter: blur(12px);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--color-line);
    }

    .nav__in { display: flex; align-items: center; gap: 16px; min-height: var(--nav-height); }

    .brand {
      position: relative;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      gap: 12px;
      min-height: 44px;
      min-width: 0;
      margin-right: auto;
    }
    .brand :global(.mark) { width: 30px; height: 30px; color: var(--color-bone); }
    .brand:hover :global(.mark__c) { animation: blink .5s steps(1, end) 3; }
    .brand__name { font: 700 16px/1.1 var(--font-display); font-stretch: 108%; letter-spacing: -.01em; white-space: nowrap; }

    .nav__links { display: none; }
    .nav__links ul { display: flex; gap: 4px; }
    .nav__links a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 12px;
      border-radius: var(--radius-corner-sm);
      font-size: 15px;
      font-weight: 500;
      color: var(--color-fog);
      transition: color .15s, background-color .15s;
    }
    .nav__links a:hover { color: var(--color-bone); background: var(--color-ink-1); }
    .nav__links a[aria-current] { color: var(--color-bone); }
    .nav__links a[aria-current]::after { content: ""; width: 5px; height: 11px; margin-left: 7px; background: var(--color-signal); }

    .nav__cta { display: none; min-height: 44px; padding: 0 18px; }

    .menu > summary {
      position: relative;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      min-height: 44px;
      padding: 0 14px;
      border: 1px solid var(--color-line-strong);
      border-radius: var(--radius-corner-sm);
      font: 600 14px/1 var(--font-body);
      list-style: none;
      cursor: pointer;
      user-select: none;
    }
    .menu > summary::-webkit-details-marker { display: none; }
    .menu__icon { position: relative; width: 16px; height: 10px; }
    .menu__icon::before,
    .menu__icon::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      height: 2px;
      background: currentColor;
      transition: transform .25s var(--ease-out), top .25s var(--ease-out);
    }
    .menu__icon::before { top: 0; }
    .menu__icon::after { top: 8px; }
    .menu[open] .menu__icon::before { top: 4px; transform: rotate(45deg); }
    .menu[open] .menu__icon::after { top: 4px; transform: rotate(-45deg); }
    .menu__close { display: none; }
    .menu[open] .menu__open { display: none; }
    .menu[open] .menu__close { display: inline; }

    .menu__sheet {
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      z-index: 1;
      padding: 8px var(--container-padding) 28px;
      background: var(--color-ink-0);
      border-bottom: 1px solid var(--color-line);
      box-shadow: 0 0 0 100vmax rgb(5 8 18 / .72);
      animation: sheet-in .28s var(--ease-out);
    }
    .menu__sheet ul { display: grid; }
    .menu__sheet li + li { border-top: 1px solid var(--color-line); }
    .menu__sheet a:not(.btn) {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 60px;
      font: 700 clamp(22px, 6cqi, 28px)/1 var(--font-display);
      font-stretch: 110%;
    }
    .menu__sheet a:not(.btn) span { font: 500 12px/1 var(--font-mono); letter-spacing: .1em; color: var(--color-mist); }
    .menu__sheet .btn { width: 100%; min-height: 52px; margin-top: 20px; }

    @container site (max-width: 379px) {
      .brand__name { display: none; }
    }
    @container site (min-width: 600px) {
      .nav__cta { display: inline-flex; }
      .menu__sheet .btn { display: none; }
    }
    @container site (min-width: 1060px) {
      .nav__in { gap: 24px; }
      .nav__links { display: block; }
      .menu { display: none; }
    }
  }

  @keyframes sheet-in { from { opacity: 0; transform: translateY(-8px); } }
</style>
