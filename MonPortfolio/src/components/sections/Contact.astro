---
/**
 * Contact.astro — formulaire Formspree + Turnstile, et les autres façons de me joindre.
 * Formspree : https://formspree.io/f/mrejobke
 * Turnstile  : 0x4AAAAAADML4xDhDRFZnWrK
 *
 * États couverts (voir le script) :
 * - erreurs par champ, validées à la perte de focus puis à l'envoi, focus sur le premier champ fautif
 * - envoi en cours : bouton verrouillé, curseur qui clignote
 * - succès : la confirmation remplace le formulaire et prend le focus
 * - échec réseau ou serveur : message au-dessus du bouton, saisie conservée
 * - anti-spam : champ piège, jeton JS, délai minimal ; un bot reçoit une fausse réussite
 */
const FORMSPREE_ENDPOINT = import.meta.env.PUBLIC_FORMSPREE_ID
  ? `https://formspree.io/f/${import.meta.env.PUBLIC_FORMSPREE_ID}`
  : 'https://formspree.io/f/mrejobke';

const TURNSTILE_SITE_KEY: string = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '0x4AAAAAADML4xDhDRFZnWrK';
const LINKEDIN = 'https://fr.linkedin.com/in/%F0%9F%92%BB-lucas-jimenez-boulot-35629919b';
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container">
    <header class="section-head reveal">
      <p class="kicker">Contact</p>
      <h2 class="title" id="contact-title">Vous avez un projet&nbsp;?</h2>
      <p class="lead">Refonte, nouvelle application ou question technique : écrivez-moi ici ou sur LinkedIn, même délai de réponse.</p>
    </header>

    <div class="contact">
      <div class="card">
        <form id="contact-form" class="form" novalidate data-endpoint={FORMSPREE_ENDPOINT} aria-label="Formulaire de contact">
          <div class="form__row">
            <div class="field">
              <label for="contact-nom">Nom</label>
              <input class="input" type="text" id="contact-nom" name="nom" placeholder="Jean Dupont" required autocomplete="name" aria-describedby="error-nom" />
              <p id="error-nom" class="err" role="alert" hidden>
                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="6.25" stroke="currentColor" stroke-width="1.5" /><path d="M8 4.75v3.75M8 11h.01" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" /></svg>
                <span></span>
              </p>
            </div>
            <div class="field">
              <label for="contact-email">Email</label>
              <input class="input" type="email" id="contact-email" name="email" placeholder="jean@exemple.fr" required autocomplete="email" inputmode="email" aria-describedby="error-email" />
              <p id="error-email" class="err" role="alert" hidden>
                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="6.25" stroke="currentColor" stroke-width="1.5" /><path d="M8 4.75v3.75M8 11h.01" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" /></svg>
                <span></span>
              </p>
            </div>
          </div>

          <div class="field">
            <label for="contact-sujet">Sujet <small>(optionnel)</small></label>
            <input class="input" type="text" id="contact-sujet" name="sujet" placeholder="Refonte de site, question Drupal, mission…" autocomplete="off" />
          </div>

          <div class="field">
            <label for="contact-message">Message</label>
            <textarea class="input" id="contact-message" name="message" rows="5" placeholder="Parlez-moi de votre projet, de votre besoin ou de votre question." required aria-describedby="error-message"></textarea>
            <p id="error-message" class="err" role="alert" hidden>
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="6.25" stroke="currentColor" stroke-width="1.5" /><path d="M8 4.75v3.75M8 11h.01" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" /></svg>
              <span></span>
            </p>
          </div>

          {/* Turnstile — rendu en mode explicit après chargement différé */}
          <div id="turnstile-container" class="turnstile" data-sitekey={TURNSTILE_SITE_KEY} role="group" aria-label="Vérification de sécurité"></div>
          <p id="error-turnstile" class="err" role="alert" hidden>
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="6.25" stroke="currentColor" stroke-width="1.5" /><path d="M8 4.75v3.75M8 11h.01" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" /></svg>
            <span>Cochez la vérification de sécurité avant d'envoyer.</span>
          </p>

          <div id="form-global-error" class="alert" role="alert" hidden>
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="6.25" stroke="currentColor" stroke-width="1.5" /><path d="M8 4.75v3.75M8 11h.01" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" /></svg>
            <span><span id="form-global-error-text"></span> Votre saisie est conservée. Réessayez, ou écrivez-moi sur <a class="inline-link" href={LINKEDIN} target="_blank" rel="noopener noreferrer">LinkedIn<span class="sr-only"> (nouvel onglet)</span></a>.</span>
          </div>

          <div class="form__foot">
            <button type="submit" class="btn btn--signal" id="form-submit">
              <span class="submit__idle">
                Envoyer le message
                <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
              <span class="submit__busy" hidden>Envoi<span class="caret" aria-hidden="true"></span></span>
            </button>
            <p class="form__status" id="form-status" role="status"></p>
          </div>

          {/* ── Honeypot anti-spam (couche 1 : champ piège) ── */}
          <div class="form__honeypot" aria-hidden="true">
            <label for="hp-website">Ne pas remplir</label>
            <input type="text" id="hp-website" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>
          {/* Couche 2 : jeton JS (prouve que JS tourne, les bots simples ne l'injectent pas) */}
          <input type="hidden" name="_js_token" value="" />
        </form>

        {/* Succès — remplace le formulaire */}
        <div class="done" id="form-success" role="status" aria-live="polite" hidden>
          <span class="done__icon" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none"><path d="M3.5 8.5 6.5 11.5 12.5 4.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
          <h3 tabindex="-1" id="form-success-heading">Message envoyé</h3>
          <p id="form-success-body">Je vous réponds sous 48&nbsp;h.</p>
          <button type="button" class="btn btn--line" id="form-reset">Écrire un autre message</button>
        </div>
      </div>

      <dl class="aside">
        <div><dt>Délai</dt><dd><span class="dot-ok" aria-hidden="true"></span>Réponse sous 48&nbsp;h</dd></div>
        <div>
          <dt>LinkedIn</dt>
          <dd>
            <a class="link" href={LINKEDIN} target="_blank" rel="noopener noreferrer">
              Lucas Jimenez Boulot
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span class="sr-only">(nouvel onglet)</span>
            </a>
          </dd>
        </div>
        <div><dt>Basé à</dt><dd>Montpellier, Occitanie</dd></div>
        <div><dt>Pour aller vite</dt><dd>Indiquez le type de projet, l'échéance et le lien du site actuel s'il existe.</dd></div>
      </dl>
    </div>
  </div>
</section>

<style>
  @layer components {
    .contact { display: grid; gap: 24px; }

    .form { display: grid; gap: 20px; }
    .form__row { display: grid; gap: 20px; }
    .field { display: grid; gap: 8px; min-width: 0; }
    .field label { font-size: 15px; font-weight: 600; }
    .field label small { margin-left: 4px; font-size: 14px; font-weight: 400; color: var(--color-mist); }

    /* 16 px minimum : en dessous, iOS zoome sur le champ au focus */
    .input {
      width: 100%;
      min-height: 50px;
      padding: 12px 14px;
      border: 1px solid var(--color-line-strong);
      border-radius: var(--radius-corner-sm);
      background: var(--color-ink-0);
      font: 400 16px/1.5 var(--font-body);
      color: var(--color-bone);
      transition: border-color .15s, box-shadow .15s;
    }
    textarea.input { min-height: 140px; resize: vertical; }
    .input::placeholder { color: var(--color-mist); opacity: 1; }
    .input:hover { border-color: var(--color-line-hover); }
    .input:focus { outline: none; border-color: var(--color-signal); box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-signal) 28%, transparent); }
    .input[aria-invalid="true"] { border-color: var(--color-err); }

    .err { display: flex; align-items: flex-start; gap: 8px; font-size: 14.5px; color: var(--color-err); }
    .err svg { flex: none; width: 16px; height: 16px; margin-top: 3px; }

    .turnstile:empty { display: none; }

    .alert {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 14px 16px;
      border: 1px solid color-mix(in srgb, var(--color-err) 50%, var(--color-line));
      border-radius: var(--radius-corner-sm);
      background: color-mix(in srgb, var(--color-err) 8%, var(--color-ink-0));
      font-size: 15px;
    }
    .alert svg { flex: none; width: 18px; height: 18px; margin-top: 2px; color: var(--color-err); }
    .inline-link { font-weight: 600; text-decoration: underline 1.5px var(--color-signal); text-underline-offset: 3px; }

    .form__foot { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 20px; }
    .form__foot .btn { width: 100%; }
    .submit__idle, .submit__busy { display: inline-flex; align-items: center; gap: 10px; }
    .submit__busy .caret { height: 1em; margin-left: 2px; }
    .form__status { font-size: 14px; color: var(--color-mist); }
    .form__status:empty { display: none; }

    .form__honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

    .done { display: grid; justify-items: start; gap: 14px; padding-block: 12px; }
    .done__icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: var(--radius-corner-sm); background: color-mix(in srgb, var(--color-ok) 16%, var(--color-ink-0)); color: var(--color-ok); }
    .done__icon svg { width: 22px; height: 22px; }
    .done h3 { font: 750 26px/1.1 var(--font-display); font-stretch: 110%; }
    .done h3:focus { outline: none; }
    .done p { color: var(--color-fog); }

    .aside { display: grid; align-content: start; border-top: 1px solid var(--color-line); }
    .aside > div { display: grid; gap: 6px; padding: 20px 0; border-bottom: 1px solid var(--color-line); }
    .aside dt { font: 500 12px/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--color-mist); }
    .aside dd { font-size: 16px; }
    .aside .link { margin-block: -8px; }
    .dot-ok { display: inline-block; width: 8px; height: 8px; margin-right: 8px; border-radius: 50%; background: var(--color-ok); vertical-align: .1em; }

    @container site (min-width: 600px) {
      .form__row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .form__foot .btn { width: auto; }
    }
    @container site (min-width: 960px) {
      .contact { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: 48px; align-items: start; }
    }
  }
</style>

<script>
  const MESSAGES = {
    nom: 'Indiquez votre nom.',
    emailEmpty: 'Indiquez votre adresse email.',
    emailInvalid: 'Adresse incomplète : vérifiez le @ et le domaine, par exemple jean@exemple.fr.',
    message: 'Écrivez votre message.',
    network: "Le message n'est pas parti : le service d'envoi n'a pas répondu.",
    server: "Le message n'est pas parti : le service d'envoi l'a refusé.",
  } as const;

  const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  interface TurnstileApi {
    render: (container: HTMLElement, options: Record<string, string>) => void;
    reset: () => void;
  }

  interface TurnstileWindow extends Window {
    turnstile?: TurnstileApi;
    onTurnstileLoad?: () => void;
  }

  const turnstileWindow = window as TurnstileWindow;

  // ── Initialisation (IIFE pour éviter le return au niveau module) ──
  (function initContactForm(): void {
    const form        = document.getElementById('contact-form')         as HTMLFormElement   | null;
    const submitBtn   = document.getElementById('form-submit')          as HTMLButtonElement | null;
    const globalError = document.getElementById('form-global-error')    as HTMLElement       | null;
    const globalText  = document.getElementById('form-global-error-text') as HTMLElement     | null;
    const statusEl    = document.getElementById('form-status')          as HTMLElement       | null;
    const successEl   = document.getElementById('form-success')         as HTMLElement       | null;
    const successHead = document.getElementById('form-success-heading') as HTMLElement       | null;
    const successBody = document.getElementById('form-success-body')    as HTMLElement       | null;
    const resetBtn    = document.getElementById('form-reset')           as HTMLButtonElement | null;

    if (!form || !submitBtn) return;

    const endpoint = form.dataset.endpoint ?? '';

    // ── Anti-spam : couche 2 — jeton JS injecté au runtime ──────────
    // Un bot simple qui parse le HTML ne verra jamais cette valeur injectée dynamiquement
    const jsTokenField = form.querySelector<HTMLInputElement>('[name="_js_token"]');
    if (jsTokenField) jsTokenField.value = 'human_' + Math.random().toString(36).slice(2, 9);

    // ── Anti-spam : couche 3 — horodatage de chargement du form ─────
    // Rejet si le formulaire est soumis en moins de 2,5 s (impossible pour un humain)
    const formLoadTime = Date.now();

    // ── Helpers ───────────────────────────────────────────────────

    /** Marque un champ invalide avec ARIA et affiche son message */
    function setFieldError(id: string, errorId: string, message: string, invalid: boolean): void {
      const field = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
      const err   = document.getElementById(errorId);
      if (!field || !err) return;

      field.setAttribute('aria-invalid', invalid ? 'true' : 'false');
      const text = err.querySelector('span');
      if (text) text.textContent = message;
      err.hidden = !invalid;
    }

    function clearAllErrors(): void {
      setFieldError('contact-nom',     'error-nom',     '', false);
      setFieldError('contact-email',   'error-email',   '', false);
      setFieldError('contact-message', 'error-message', '', false);
      const tsErr = document.getElementById('error-turnstile');
      if (tsErr) tsErr.hidden = true;
      if (globalError) globalError.hidden = true;
    }

    function showGlobalError(message: string): void {
      if (globalText) globalText.textContent = message;
      if (globalError) globalError.hidden = false;
    }

    /** Bouton verrouillé + curseur qui clignote pendant l'envoi */
    function setLoading(on: boolean): void {
      submitBtn!.disabled = on;
      submitBtn!.setAttribute('aria-busy', String(on));
      submitBtn!.querySelector<HTMLElement>('.submit__idle')!.hidden = on;
      submitBtn!.querySelector<HTMLElement>('.submit__busy')!.hidden = !on;
      if (statusEl) statusEl.textContent = on ? 'Envoi du message…' : '';
    }

    function showSuccess(email: string): void {
      // Remplacer le formulaire par la confirmation
      form!.hidden = true;
      if (successEl) successEl.hidden = false;
      if (successBody && email) {
        successBody.textContent = `Je vous réponds sous 48 h à l'adresse ${email}.`;
      }
      // Gestion du focus — WCAG 2.4.3
      successHead?.focus();
    }

    function resetToForm(): void {
      if (successEl) successEl.hidden = true;
      form!.hidden = false;
      form!.reset();
      clearAllErrors();
      turnstileWindow.turnstile?.reset();
      (document.getElementById('contact-nom') as HTMLInputElement | null)?.focus();
    }

    function emailError(value: string): string {
      if (!value) return MESSAGES.emailEmpty;
      return EMAIL_PATTERN.test(value) ? '' : MESSAGES.emailInvalid;
    }

    // ── Validation à la perte de focus (blur) — UX proactive ──────

    const requiredFields: [string, string, string][] = [
      ['contact-nom', 'error-nom', MESSAGES.nom],
      ['contact-message', 'error-message', MESSAGES.message],
    ];
    requiredFields.forEach(([id, errorId, message]) => {
      const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
      el?.addEventListener('blur', () => {
        setFieldError(id, errorId, message, !el.value.trim());
      });
    });

    const emailEl = document.getElementById('contact-email') as HTMLInputElement | null;
    emailEl?.addEventListener('blur', () => {
      const message = emailError(emailEl.value.trim());
      setFieldError('contact-email', 'error-email', message, message !== '');
    });

    // ── Soumission ────────────────────────────────────────────────

    form.addEventListener('submit', async (e: Event) => {
      e.preventDefault();
      clearAllErrors();

      const nom     = (form.querySelector('#contact-nom')     as HTMLInputElement).value.trim();
      const email   = (form.querySelector('#contact-email')   as HTMLInputElement).value.trim();
      const message = (form.querySelector('#contact-message') as HTMLTextAreaElement).value.trim();

      // ── Anti-spam : vérifications honeypot ──────────────────────────
      const honeypot = form.querySelector<HTMLInputElement>('[name="_gotcha"]');
      const jsToken  = form.querySelector<HTMLInputElement>('[name="_js_token"]');
      const elapsed  = Date.now() - formLoadTime;

      const isBot =
        (honeypot?.value && honeypot.value.length > 0) || // couche 1 : champ piège rempli
        !jsToken?.value.startsWith('human_')            || // couche 2 : jeton JS absent/invalide
        elapsed < 2500;                                    // couche 3 : soumis < 2,5 s

      if (isBot) {
        // Fausse réussite — le bot croit avoir réussi, on ne lui indique rien
        showSuccess(email);
        return;
      }
      // ────────────────────────────────────────────────────────────────

      // Validation complète
      let hasError = false;

      if (!nom) {
        setFieldError('contact-nom', 'error-nom', MESSAGES.nom, true);
        hasError = true;
      }
      const emailMessage = emailError(email);
      if (emailMessage) {
        setFieldError('contact-email', 'error-email', emailMessage, true);
        hasError = true;
      }
      if (!message) {
        setFieldError('contact-message', 'error-message', MESSAGES.message, true);
        hasError = true;
      }

      // Validation Turnstile
      const tsToken = form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]');
      if (!tsToken?.value) {
        const tsErr = document.getElementById('error-turnstile');
        if (tsErr) tsErr.hidden = false;
        hasError = true;
      }

      if (hasError) {
        // Focus sur le premier champ en erreur
        form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
        return;
      }

      setLoading(true);

      try {
        const formData = new FormData(form);
        const payload: Record<string, string> = {};
        formData.forEach((v, k) => { if (typeof v === 'string') payload[k] = v; });

        const res = await fetch(endpoint, {
          method:  'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body:    JSON.stringify(payload),
        });

        if (res.ok) {
          showSuccess(email);
        } else {
          const data: unknown = await res.json().catch(() => ({}));
          const serverMessage = typeof data === 'object' && data !== null && 'error' in data && typeof data.error === 'string' ? data.error : '';
          showGlobalError(serverMessage ? `${MESSAGES.server} (${serverMessage})` : MESSAGES.server);
        }
      } catch {
        showGlobalError(MESSAGES.network);
      } finally {
        setLoading(false);
      }
    });

    // ── Bouton « Écrire un autre message » ─────────────────────────
    resetBtn?.addEventListener('click', resetToForm);
  })(); // fin IIFE initContactForm

  // ══════════════════════════════════════════════════════════════════
  // Turnstile — chargement LAZY via IntersectionObserver
  // Ne se charge QUE quand l'utilisateur approche la section Contact
  // (évite de bloquer le chargement de la page entière au démarrage)
  // ══════════════════════════════════════════════════════════════════
  (function initTurnstileLazy(): void {
    const container = document.getElementById('turnstile-container');
    const section   = document.getElementById('contact');
    const siteKey   = container?.dataset.sitekey;
    if (!container || !section || !siteKey) return;

    let loaded = false;

    const loadTurnstile = (): void => {
      if (loaded) return;
      loaded = true;

      const script = document.createElement('script');
      // Mode explicit : Turnstile n'initialise rien automatiquement
      script.src   = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad';
      script.async = true;
      script.defer = true;
      document.head.appendChild(script);
    };

    // Callback global appelé par Turnstile une fois son script chargé
    turnstileWindow.onTurnstileLoad = () => {
      turnstileWindow.turnstile?.render(container, {
        sitekey: siteKey,
        theme:   'dark',
        size:    'flexible',
      });
    };

    // Observer : déclenche le chargement 300px avant que la section soit visible
    const obs = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          obs.disconnect();
          loadTurnstile();
        }
      },
      { rootMargin: '300px' }
    );

    obs.observe(section);
  })();
</script>
