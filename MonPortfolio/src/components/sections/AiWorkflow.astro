---
/**
 * AiWorkflow — Développement assisté par IA.
 *
 * Section pensée pour l'entretien technique : elle ne liste pas des noms
 * d'assistants (ça, c'est la ligne « IA & Productivité » de la stack), elle
 * montre l'outillage construit autour d'eux et les garde-fous qui le rendent
 * utilisable sur du code client.
 *
 * Chaque entrée porte un `role` explicite — « Conçu et développé » ou
 * « Intégré et orchestré ». La distinction est volontaire : revendiquer la
 * paternité d'un outil tiers est le genre de détail qui se vérifie en
 * entretien, et il vaut mieux que la nuance vienne de moi.
 */

interface Tool {
  name: string;
  role: 'built' | 'wired';
  desc: string;
  tags: string[];
}

/** Chaîne d'exécution de drupal-expert, dans l'ordre réel de dispatch. */
const pipeline: string[] = [
  'scanner',
  'builder',
  'code-reviewer',
  'verifier',
  'backup',
  'applier',
  'post-check',
];

/** Portée réelle du déploiement, comptée sur le disque. */
const portee = [
  { valeur: '10', label: 'sous-agents' },
  { valeur: '10', label: 'skills' },
  { valeur: '11', label: 'projets équipés' },
  { valeur: '4',  label: 'runtimes' },
];

/** Les quatre formats d'agent sur lesquels la chaîne est portée. */
const runtimes: string[] = ['.claude', '.continue', '.cortex', '.agents'];

const guards: string[] = [
  'Sauvegarde datée avant chaque application',
  'Auto-correction en boucle si la revue échoue',
  'Diagnostic automatique en cas d’échec',
];

const tools: Tool[] = [
  {
    name: 'mamp-to-docker-db',
    role: 'built',
    desc: "Sort la base MySQL d'un projet Drupal de MAMP vers un conteneur Docker isolé, en laissant PHP sur l'hôte ou en le conteneurisant aussi. La skill détecte le port, la version MySQL et le nom de base, ou vous les demande, et ne code jamais rien en dur.",
    tags: ['Docker', 'MySQL', 'Drupal', 'Shell'],
  },
  {
    name: 'Mémoire persistante & hooks',
    role: 'wired',
    desc: "Serveur MCP branché sur le cycle de vie des sessions : je rappelle le contexte au démarrage et je l'écris avant compaction. PostgreSQL et les embeddings Ollama tournent en local, donc aucune ligne de code ne quitte la machine. Un garde-fou intercepte les lectures de fichiers et signale un contexte périmé.",
    tags: ['MCP', 'Hooks', 'PostgreSQL', 'Ollama'],
  },
  {
    name: 'Manuel opératoire versionné',
    role: 'built',
    desc: "Chaque projet porte son CLAUDE.md : conventions, commandes et pièges déjà rencontrés. J'y répète la même règle partout : aller vérifier dans le fichier avant d'affirmer quoi que ce soit sur le code.",
    tags: ['Documentation', 'Conventions', 'Onboarding'],
  },
];

const roleLabel: Record<Tool['role'], string> = {
  built: 'Conçu et développé',
  wired: 'Intégré et orchestré',
};
---

<section id="ia" class="section section--alt" data-section aria-label="Développement assisté par IA">
  <div class="container">

    <header class="ai__header reveal">
      <span class="section-label">Workflow</span>
      <h2 class="section-title">Développement assisté par IA</h2>
      <p class="section-subtitle">
        Sur du code client, une intervention assistée doit rester aussi vérifiable
        qu'une intervention manuelle. Je construis l'outillage qui l'impose :
        des sous-agents spécialisés et une double vérification avant toute
        écriture dans un projet.
      </p>
    </header>

    {/* ── Pièce maîtresse : la chaîne de sous-agents ── */}
    <article class="ai__feature card reveal" aria-label="drupal-expert, chaîne de sous-agents">
      <div class="ai__feature-head">
        <div>
          <h3 class="ai__feature-title">drupal-expert</h3>
          <p class="ai__feature-sub">10 sous-agents et 10 skills, portés sur 4 runtimes</p>
        </div>
        <span class="ai__role ai__role--built">{roleLabel.built}</span>
      </div>

      <p class="ai__feature-desc">
        L'orchestrateur évalue le risque d'une demande Drupal, choisit le niveau
        d'autonomie, puis passe la main à des sous-agents dédiés. L'applier n'écrit
        dans le projet qu'après trois feux verts : sauvegarde créée, revue de code
        passée, configuration validée.
      </p>

      <p class="ai__feature-desc">
        J'ai porté la chaîne sur quatre runtimes d'agent et je l'ai installée sur
        onze projets Drupal de l'agence, qui l'utilisent avec la même séquence et
        les mêmes garde-fous.
      </p>

      <ol class="ai__pipeline" aria-label="Étapes de la chaîne d'exécution">
        {pipeline.map((step, i) => (
          <li class="ai__step">
            <span class="ai__step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="ai__step-name">{step}</span>
          </li>
        ))}
      </ol>

      <ul class="ai__guards" aria-label="Garde-fous">
        {guards.map(g => (
          <li class="ai__guard">
            <svg aria-hidden="true" width="13" height="13" viewBox="0 0 16 16" fill="none">
              <path d="M8 1.5 2.5 4v4c0 3.2 2.3 5.9 5.5 6.5 3.2-.6 5.5-3.3 5.5-6.5V4L8 1.5Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
              <path d="m5.75 8 1.6 1.6 3-3.2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {g}
          </li>
        ))}
      </ul>

      <dl class="ai__stats" aria-label="Portée du déploiement">
        {portee.map(p => (
          <div class="ai__stat">
            <dt class="ai__stat-label">{p.label}</dt>
            <dd class="ai__stat-value">{p.valeur}</dd>
          </div>
        ))}
      </dl>

      <ul class="ai__runtimes" aria-label="Formats d'agent supportés">
        {runtimes.map(r => <li><span class="tag">{r}</span></li>)}
      </ul>
    </article>

    {/* ── Le reste de l'outillage ── */}
    <div class="ai__grid">
      {tools.map(tool => (
        <article class="ai__tool card reveal" aria-label={tool.name}>
          <div class="ai__tool-head">
            <h3 class="ai__tool-title">{tool.name}</h3>
            <span class:list={['ai__role', tool.role === 'built' ? 'ai__role--built' : 'ai__role--wired']}>
              {roleLabel[tool.role]}
            </span>
          </div>
          <p class="ai__tool-desc">{tool.desc}</p>
          <ul class="ai__tool-tags" aria-label={`Technologies : ${tool.name}`}>
            {tool.tags.map(t => <li><span class="tag">{t}</span></li>)}
          </ul>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .ai__header { margin-bottom: var(--space-12); }

  /* ── Pièce maîtresse ── */
  .ai__feature {
    padding: var(--space-8);
    margin-bottom: var(--space-6);
  }

  .ai__feature-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }

  .ai__feature-title {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
  }

  .ai__feature-sub {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-2);
  }

  .ai__feature-desc {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-2);
    max-width: 78ch;
    margin-bottom: var(--space-8);
  }

  /* ── Badge de rôle ──
     La nuance auteur / intégrateur est portée par la couleur : accent pour
     ce que j'ai écrit, neutre pour ce que je me contente d'orchestrer. */
  .ai__role {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    white-space: nowrap;
    border: 1px solid;
  }

  .ai__role--built {
    color: var(--color-accent-text);
    background: var(--color-accent-light);
    border-color: var(--color-border-accent);
  }

  .ai__role--wired {
    color: var(--color-text-2);
    background: var(--color-surface-2);
    border-color: var(--color-border);
  }

  /* ── Chaîne d'exécution ──
     Une liste ordonnée qui se lit comme un tuyau : les flèches sont
     décoratives et disparaissent en fin de ligne. */
  .ai__pipeline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin-bottom: var(--space-6);
  }

  .ai__step {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: 0.35rem 0.7rem;
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text);
  }

  /*
    Pas de flèche de liaison entre les étapes : en position absolue elle
    pendait dans le vide en fin de ligne dès que la chaîne se repliait, et
    le repli dépend de la largeur disponible, pas d'un palier de media query.
    Les numéros 01→07 en couleur d'accent portent déjà l'ordre sans rien
    devoir à la mise en page.
  */
  .ai__step-num { color: var(--color-accent); }

  .ai__guards {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    list-style: none;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .ai__guard {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-2);
  }

  .ai__guard svg { color: var(--color-accent); flex-shrink: 0; }

  /* ── Portée du déploiement ──
     Des chiffres alignés plutôt qu'une phrase : « 11 projets » se lit d'un
     coup d'œil là où « déployé sur onze projets » se lit en entier. */
  .ai__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-8);
    padding-top: var(--space-5);
    margin-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .ai__stat {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-1);
  }

  /* `column-reverse` : le chiffre s'affiche au-dessus du libellé, mais le
     <dt> reste avant le <dd> dans le DOM, comme une liste de définition. */
  .ai__stat-value {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent-text);
    line-height: 1;
  }

  .ai__stat-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-3);
  }

  .ai__runtimes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin-top: var(--space-4);
  }

  /* ── Grille d'outils ── */
  .ai__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--space-6);
  }

  .ai__tool {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .ai__tool-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .ai__tool-title {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    letter-spacing: var(--tracking-tight);
  }

  .ai__tool-desc {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-2);
    flex: 1;
  }

  .ai__tool-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin-top: auto;
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .ai__feature { padding: var(--space-5); }
    .ai__tool    { padding: var(--space-5); }
  }
</style>
