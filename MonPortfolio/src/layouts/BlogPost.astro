---
/**
 * BlogPost.astro — Layout pour les articles de blog
 * Fil d'Ariane, méta OG, JSON-LD BlogPosting, bio auteur.
 * La mise en forme du Markdown (.prose) vise une colonne de lecture de 68 caractères.
 */
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import profile from '@/assets/profile.jpeg';
import { formatDate } from '@/utils/format';

interface Props {
  title:       string;
  date:        Date;
  excerpt:     string;
  tags:        string[];
  readingTime: number;
  ogImage?:    string;
}

const { title, date, excerpt, tags, readingTime, ogImage } = Astro.props;

const formattedDate = formatDate(new Date(date));
const isoDate  = new Date(date).toISOString();
const base     = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteBase = String(Astro.site ?? '').replace(/\/$/, '');
const pageURL  = Astro.url.href;

const jsonLd = {
  '@context':        'https://schema.org',
  '@type':           'BlogPosting',
  headline:          title,
  description:       excerpt,
  datePublished:     isoDate,
  inLanguage:        'fr-FR',
  url:               pageURL,
  author: {
    '@type': 'Person',
    name:    'Lucas Jimenez Boulot',
    url:     siteBase,
  },
  publisher: {
    '@type': 'Person',
    name:    'Lucas Jimenez Boulot',
    url:     siteBase,
  },
  keywords: tags?.join(', '),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type':    'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: siteBase + '/' },
    { '@type': 'ListItem', position: 2, name: 'Blog',    item: siteBase + '/blog/' },
    { '@type': 'ListItem', position: 3, name: title,     item: pageURL },
  ],
};
---

<BaseLayout
  title={`${title} · Lucas Jimenez Boulot`}
  description={excerpt}
  ogImage={ogImage}
  ogType="article"
  publishedTime={isoDate}
  articleTags={tags}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} slot="head" />

  <article class="article">
    <div class="container">
      <nav class="crumbs" aria-label="Fil d'Ariane">
        <a href={`${base}/`}>Accueil</a>
        <span aria-hidden="true">/</span>
        <a href={`${base}/blog/`}>Blog</a>
        <span aria-hidden="true">/</span>
        <span class="crumbs__current" aria-current="page">{title}</span>
      </nav>

      <header class="article__head">
        <p class="article__meta">
          <time datetime={isoDate}>{formattedDate}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime} min de lecture</span>
        </p>
        <h1 class="article__title">{title}</h1>
        <p class="article__excerpt">{excerpt}</p>
        {tags.length > 0 && (
          <ul class="tags" aria-label="Sujets de l'article">
            {tags.map(tag => <li class="tag">{tag}</li>)}
          </ul>
        )}
      </header>

      <div class="prose">
        <slot />
      </div>

      <footer class="article__foot">
        <div class="author">
          <Image src={profile} alt="" width={112} height={112} loading="lazy" />
          <div>
            <p class="author__name">Lucas Jimenez Boulot</p>
            <p class="author__role">Développeur full-stack · Montpellier</p>
            <p class="author__bio">
              Je conçois et développe des applications web : Drupal, PHP, React, JS.
              Ce blog documente mes retours d'expérience.
            </p>
          </div>
        </div>

        <a href={`${base}/blog/`} class="btn btn--line">
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M13 8H3M7 4 3 8l4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
          Tous les articles
        </a>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  @layer components {
    .article { padding-block: clamp(40px, 6cqi, 80px) var(--space-section); }

    .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; margin-bottom: 28px; font: 500 13px/1 var(--font-mono); color: var(--color-mist); }
    .crumbs a { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-fog); }
    .crumbs a:hover { color: var(--color-bone); }
    .crumbs span[aria-hidden] { color: var(--color-line-strong); }
    /* Titre long : coupé sur une ligne, il reste en entier dans le h1 juste en dessous */
    .crumbs__current { min-width: 0; max-width: 100%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; line-height: 1.4; }

    .article__head { display: grid; gap: 18px; max-width: 900px; padding-bottom: clamp(32px, 5cqi, 56px); margin-bottom: clamp(32px, 5cqi, 56px); border-bottom: 1px solid var(--color-line); }
    .article__meta { display: flex; flex-wrap: wrap; gap: 4px 10px; font: 500 13px/1.4 var(--font-mono); color: var(--color-mist); }
    .article__title { font: 800 clamp(2rem, 5.6cqi, 4rem)/1.04 var(--font-display); font-stretch: 112%; letter-spacing: -.028em; text-wrap: balance; }
    .article__excerpt { max-width: 62ch; font-size: clamp(17px, 1.9cqi, 20px); line-height: 1.55; color: var(--color-fog); text-wrap: pretty; }

    /* ── Contenu Markdown ── */
    .prose { max-width: 70ch; font-size: 17.5px; line-height: 1.75; color: #CFD3DE; }
    .prose > :global(* + *) { margin-top: 1.25em; }
    .prose :global(h1),
    .prose :global(h2) { margin-top: 2.4em; font: 750 clamp(24px, 3cqi, 30px)/1.2 var(--font-display); font-stretch: 108%; letter-spacing: -.02em; color: var(--color-bone); }
    .prose :global(h3) { margin-top: 1.9em; font: 650 20px/1.3 var(--font-body); color: var(--color-bone); }
    .prose :global(:is(h1, h2, h3) + *) { margin-top: .75em; }
    .prose :global(strong) { color: var(--color-bone); }
    .prose :global(a) { color: var(--color-bone); text-decoration: underline 1.5px var(--color-signal); text-underline-offset: 3px; }
    .prose :global(a:hover) { text-decoration-thickness: 2.5px; }
    .prose :global(ul),
    .prose :global(ol) { display: grid; gap: .5em; padding-left: 1.4em; }
    .prose :global(ul) { list-style: square; }
    .prose :global(ol) { list-style: decimal; }
    .prose :global(li::marker) { color: var(--color-signal); }
    .prose :global(blockquote) { padding: 4px 0 4px 20px; border-left: 3px solid var(--color-signal); color: var(--color-fog); }
    .prose :global(hr) { height: 1px; border: 0; background: var(--color-line); margin-block: 2.5em; }

    /* Les blocs de code et les tableaux défilent dans leur boîte, jamais la page */
    .prose :global(pre) {
      overflow-x: auto;
      padding: 20px 22px;
      border: 1px solid var(--color-line);
      border-radius: var(--radius-corner-sm);
      background: var(--color-ink-1) !important;
      font: 400 14px/1.7 var(--font-mono);
    }
    .prose :global(pre code) { padding: 0; border: 0; background: none; font-size: inherit; }
    .prose :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; font-size: 15px; }
    .prose :global(th),
    .prose :global(td) { padding: 10px 14px; border-bottom: 1px solid var(--color-line); text-align: left; vertical-align: top; }
    .prose :global(th) { font: 500 12px/1.4 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--color-mist); white-space: nowrap; }

    .article__foot { display: grid; gap: 28px; justify-items: start; max-width: 70ch; margin-top: clamp(48px, 7cqi, 88px); padding-top: 36px; border-top: 1px solid var(--color-line); }
    .author { display: flex; align-items: flex-start; gap: 18px; padding: 24px; border: 1px solid var(--color-line); border-radius: var(--radius-corner); background: var(--color-ink-1); }
    .author img { flex: none; width: 56px; height: 56px; object-fit: cover; object-position: 38% 22%; border-radius: var(--radius-corner-sm); }
    .author__name { font: 700 17px/1.2 var(--font-display); font-stretch: 108%; }
    .author__role { margin-top: 2px; font: 500 12.5px/1.4 var(--font-mono); color: var(--color-mist); }
    .author__bio { margin-top: 10px; font-size: 15.5px; color: var(--color-fog); }
  }
</style>
