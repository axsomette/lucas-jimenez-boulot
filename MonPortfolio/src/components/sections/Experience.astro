---
/**
 * Experience — parcours, du poste actuel au premier.
 * L'année de départ et les durées sont calculées depuis la collection.
 */
import { getCollection } from 'astro:content';
import { durationLabel, formatPeriod } from '@/utils/format';

const allExperiences = await getCollection('experiences');
const experiences = allExperiences.sort((a, b) => a.data.order - b.data.order);

const firstYear: number = Math.min(...experiences.map(xp => xp.data.startDate.getFullYear()));
const allCdi: boolean = experiences.every(xp => xp.data.type === 'CDI');
const allOccitanie: boolean = experiences.every(xp => xp.data.location.includes('Occitanie'));
const summary: string = `${experiences.length} poste${experiences.length > 1 ? 's' : ''}${allCdi ? ' en CDI' : ''} depuis${allOccitanie ? ', tous en Occitanie' : ''}.`;
---

<section id="parcours" class="section" aria-labelledby="parcours-title">
  <div class="container">
    <header class="section-head reveal">
      <p class="kicker">Parcours</p>
      <h2 class="title" id="parcours-title">Expérience</h2>
      <p class="lead">
        J'interviens sur des applications métier et des sites vitrine, le plus souvent sur une stack que je n'ai pas choisie.
        Reprendre le code d'un autre, en comprendre les contraintes et livrer sans rien casser occupe l'essentiel de mon travail.
      </p>
    </header>

    <div class="xp">
      <p class="xp__since"><b>{firstYear}</b><span>Premier poste en développement web. {summary}</span></p>

      <ol class="jobs" aria-label="Postes, du plus récent au plus ancien">
        {experiences.map(xp => (
          <li class="job">
            <span class="job__when">
              {formatPeriod(xp.data.startDate, xp.data.endDate, xp.data.current)}
              {xp.data.current && <span class="caret" aria-hidden="true"></span>}
            </span>
            <h3 class="job__what">{xp.data.role}</h3>
            <span class="job__type">{xp.data.type}</span>
            <span class="job__where">{xp.data.company} · {xp.data.location.split(',')[0]}</span>
            <span class="job__len">{durationLabel(xp.data.startDate, xp.data.endDate)}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  @layer components {
    .xp { display: grid; gap: 40px; }

    .xp__since { display: grid; gap: 8px; align-content: start; }
    .xp__since b { font: 850 clamp(64px, 12cqi, 132px)/.85 var(--font-display); font-stretch: 118%; letter-spacing: -.04em; }
    .xp__since span { max-width: 26ch; color: var(--color-fog); }

    .jobs { border-top: 1px solid var(--color-line); }
    .job {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: "when type" "what what" "where len";
      gap: 6px 24px;
      align-items: baseline;
      padding: 22px 0;
      border-bottom: 1px solid var(--color-line);
    }
    .job__when { grid-area: when; font: 500 13px/1.4 var(--font-mono); color: var(--color-fog); }
    .job__when .caret { height: 1em; vertical-align: -.15em; }
    .job__what { grid-area: what; font: 700 clamp(20px, 2.4cqi, 26px)/1.2 var(--font-display); font-stretch: 108%; letter-spacing: -.015em; }
    .job__where { grid-area: where; font-size: 15.5px; color: var(--color-fog); }
    .job__len { grid-area: len; font: 500 13px/1.4 var(--font-mono); color: var(--color-mist); white-space: nowrap; }
    .job__type {
      grid-area: type;
      padding: 5px 7px;
      border: 1px solid var(--color-line);
      border-radius: var(--radius-corner-sm);
      font: 500 11.5px/1 var(--font-mono);
      letter-spacing: .08em;
      color: var(--color-mist);
    }

    @container site (min-width: 600px) {
      .job { grid-template-columns: 210px minmax(0, 1fr) auto; grid-template-areas: "when what type" "len where where"; }
    }
    @container site (min-width: 960px) {
      .xp { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 64px; }
      .xp__since { position: sticky; top: calc(var(--nav-height) + 40px); }
    }
  }
</style>
