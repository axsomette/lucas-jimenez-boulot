---
/**
 * blog/index.astro — Liste de tous les articles
 * Triés par date décroissante, hors drafts
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, readingTime } from '@/utils/format';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Blog · Lucas Jimenez Boulot"
  description="Articles techniques sur Drupal, PHP, JavaScript, PWA, et le développement web. Retours d'expérience de terrain."
>
  <section class="section blog-index" aria-labelledby="blog-index-title">
    <div class="container">
      <nav class="crumbs" aria-label="Fil d'Ariane">
        <a href={`${base}/`}>Accueil</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Blog</span>
      </nav>

      <header class="section-head">
        <p class="kicker">Blog · {posts.length} articles</p>
        <h1 class="title" id="blog-index-title">Articles techniques</h1>
        <p class="lead">
          Retours d'expérience sur Drupal, PHP et JavaScript, écrits pour des
          développeurs qui connaissent déjà les bases.
        </p>
      </header>

      {posts.length > 0 ? (
        <ul class="entries">
          {posts.map(post => (
            <li>
              <a href={`${base}/blog/${post.id}/`} class="entry">
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                <span class="entry__body">
                  <span class="entry__title">{post.data.title}</span>
                  <span class="entry__excerpt">{post.data.excerpt}</span>
                  {post.data.tags.length > 0 && (
                    <span class="entry__tags">
                      {post.data.tags.slice(0, 3).map(tag => <span class="tag">{tag}</span>)}
                    </span>
                  )}
                </span>
                <span class="entry__time">{readingTime(post.body ?? '')} min</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="lead" role="status">Les premiers articles arrivent bientôt.</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  @layer components {
    .blog-index { padding-top: clamp(40px, 6cqi, 80px); }

    .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; margin-bottom: 28px; font: 500 13px/1 var(--font-mono); color: var(--color-mist); }
    .crumbs a { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-fog); }
    .crumbs a:hover { color: var(--color-bone); }
    .crumbs span[aria-hidden] { color: var(--color-line-strong); }

    .entries { border-top: 1px solid var(--color-line); }
    .entry {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: "date time" "body body";
      gap: 10px 16px;
      padding: 26px 4px;
      border-bottom: 1px solid var(--color-line);
      transition: background-color .2s var(--ease-out);
    }
    .entry time { grid-area: date; font: 500 12.5px/1.4 var(--font-mono); color: var(--color-mist); }
    .entry__time { grid-area: time; font: 500 12.5px/1.4 var(--font-mono); color: var(--color-mist); white-space: nowrap; }
    .entry__body { grid-area: body; display: grid; gap: 10px; min-width: 0; }
    .entry__title { font: 700 clamp(20px, 2.4cqi, 27px)/1.2 var(--font-display); font-stretch: 106%; letter-spacing: -.015em; text-wrap: balance; }
    .entry__excerpt { max-width: 68ch; font-size: 15.5px; color: var(--color-fog); }
    .entry__tags { display: flex; flex-wrap: wrap; gap: 6px; }

    @media (hover: hover) {
      .entry:hover { background: var(--color-ink-1); }
      .entry:hover .entry__title { text-decoration: underline 2px var(--color-signal); text-underline-offset: 5px; }
    }

    @container site (min-width: 768px) {
      .entry { grid-template-columns: 150px minmax(0, 1fr) auto; grid-template-areas: "date body time"; align-items: baseline; padding: 30px 8px; }
    }
  }
</style>
