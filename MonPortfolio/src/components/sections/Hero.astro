---
/**
 * Hero — la thèse en trois lignes, terminée par le curseur du logo.
 * Le titre entre ligne par ligne après le rideau du chargement (--boot-delay).
 */
import { getCollection } from 'astro:content';
import { displayName } from '@/utils/format';

const experiences = await getCollection('experiences');
const current = experiences.find(xp => xp.data.current) ?? experiences.sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime())[0];
const company: string = displayName(current.data.company);
const since: number = current.data.startDate.getFullYear();
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <p class="kicker hero__eyebrow">
      <span>Montpellier, FR</span>
      <span>Développeur full-stack</span>
      <span>Chez {company} depuis {since}</span>
    </p>

    <h1 class="hero__title" id="hero-title">
      <span class="ln">Du code propre.</span>
      <span class="ln">Des produits</span>
      <span class="ln">qui marchent<span class="caret" aria-hidden="true"></span></span>
    </h1>

    <div class="hero__grid">
      <div class="hero__lead">
        <p>Je suis <strong>Lucas Jimenez Boulot</strong>. Je conçois des applications web complètes, de la base de données jusqu'à l'interface.</p>
        <div class="hero__actions">
          <a href="#projets" class="btn btn--signal">
            Voir mes projets
            <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
          <a href="https://fr.linkedin.com/in/%F0%9F%92%BB-lucas-jimenez-boulot-35629919b" class="btn btn--line" target="_blank" rel="noopener noreferrer">
            LinkedIn
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span class="sr-only">(nouvel onglet)</span>
          </a>
        </div>
      </div>

      <dl class="spec">
        <div><dt>Poste</dt><dd>{current.data.role} chez {company}, en {current.data.type}</dd></div>
        <div><dt>Terrain</dt><dd>Drupal et PHP pour des clients d'agence ; React, Next.js et Astro pour le reste</dd></div>
        <div><dt>Outillage</dt><dd>Claude Code, sous-agents et MCP, avec double vérification avant écriture</dd></div>
        <div><dt>Base</dt><dd>Montpellier, Occitanie</dd></div>
      </dl>
    </div>
  </div>
</section>

<style>
  @layer components {
    .hero { padding-block: clamp(48px, 9cqi, 128px) clamp(64px, 9cqi, 120px); }

    .hero__eyebrow { display: flex; flex-wrap: wrap; gap: 6px 18px; margin-bottom: clamp(20px, 3cqi, 36px); }
    .hero__eyebrow span:not(:first-child) { color: var(--color-mist); }
    .hero__eyebrow span:not(:first-child)::before { content: "/"; margin-right: 18px; color: var(--color-line-strong); }

    /* « DU CODE PROPRE. » mesure 10,9 em : 7,6cqi la garde sur une ligne de 600 à 1440 px */
    .hero__title {
      font-family: var(--font-display);
      font-stretch: 118%;
      font-weight: 850;
      font-size: clamp(1.5rem, 7.6cqi, 6.25rem);
      line-height: .94;
      letter-spacing: -.035em;
      text-transform: uppercase;
    }
    .hero__title .ln { display: block; animation: rise .8s var(--ease-out) both; animation-delay: calc(var(--boot-delay) + .1s); }
    .hero__title .ln:nth-child(2) { animation-delay: calc(var(--boot-delay) + .18s); }
    .hero__title .ln:nth-child(3) { animation-delay: calc(var(--boot-delay) + .26s); color: var(--color-fog); }

    .hero__grid {
      display: grid;
      gap: 40px;
      margin-top: clamp(36px, 6cqi, 80px);
      animation: fade .8s var(--ease-out) both;
      animation-delay: calc(var(--boot-delay) + .4s);
    }
    .hero__lead { display: grid; gap: 28px; align-content: start; }
    .hero__lead p { max-width: 34ch; font-size: clamp(17px, 1.9cqi, 21px); line-height: 1.55; color: var(--color-fog); text-wrap: pretty; }
    .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; }

    .spec { border-top: 1px solid var(--color-line); }
    .spec > div { display: grid; gap: 4px; padding: 14px 0; border-bottom: 1px solid var(--color-line); }
    .spec dt { font: 500 12px/1.4 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--color-mist); }
    .spec dd { font-size: 16px; line-height: 1.45; }

    /* Téléphone : chasse normale (13 % plus étroite) pour récupérer de la taille, surtitre empilé */
    @container site (max-width: 599px) {
      .hero__title { font-stretch: 100%; font-size: clamp(1.5rem, 8.8cqi, 3.5rem); }
      .hero__eyebrow { display: grid; grid-template-columns: 7px minmax(0, 1fr); gap: 6px 10px; justify-items: start; }
      .hero__eyebrow::before { grid-row: 1; }
      .hero__eyebrow span { grid-column: 2; }
      .hero__eyebrow span:not(:first-child)::before { content: none; }
    }
    @container site (min-width: 600px) {
      .hero__lead p { max-width: 40ch; }
      .spec > div { grid-template-columns: 130px minmax(0, 1fr); gap: 16px; align-items: baseline; }
    }
    @container site (min-width: 960px) {
      .hero__grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 64px; align-items: start; }
    }
  }
</style>
