---
/**
 * LatestPosts — les trois derniers articles, en liste datée.
 */
import { getCollection } from 'astro:content';
import { formatDate, readingTime } from '@/utils/format';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{latestPosts.length > 0 && (
  <section id="blog" class="section" aria-labelledby="blog-title">
    <div class="container">
      <header class="section-head reveal">
        <p class="kicker">Blog</p>
        <h2 class="title" id="blog-title">Derniers articles</h2>
        <p class="lead">Retours d'expérience sur Drupal, PHP, JavaScript et le développement web.</p>
      </header>

      <ul class="posts">
        {latestPosts.map(post => (
          <li class="post">
            <a href={`${base}/blog/${post.id}/`}>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, 'short')}</time>
              <span class="post__title">{post.data.title}</span>
              <span class="post__time">{readingTime(post.body ?? '')} min</span>
              <svg class="post__arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
          </li>
        ))}
      </ul>

      <p class="posts__more">
        <a class="link" href={`${base}/blog/`}>
          Les {allPosts.length} articles
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </p>
    </div>
  </section>
)}

<style>
  @layer components {
    .posts { border-top: 1px solid var(--color-line); }
    .post a {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: "date time" "title title";
      gap: 8px 16px;
      padding: 22px 4px;
      border-bottom: 1px solid var(--color-line);
      transition: background-color .2s var(--ease-out);
    }
    .post time { grid-area: date; font: 500 12.5px/1.4 var(--font-mono); color: var(--color-mist); }
    .post__title { grid-area: title; font: 700 clamp(19px, 2.2cqi, 25px)/1.2 var(--font-display); font-stretch: 106%; letter-spacing: -.015em; text-wrap: balance; }
    .post__time { grid-area: time; font: 500 12.5px/1.4 var(--font-mono); color: var(--color-mist); white-space: nowrap; }
    .post__arrow { display: none; }
    .posts__more { margin-top: 20px; }

    @media (hover: hover) {
      .post a:hover { background: var(--color-ink-1); }
      .post a:hover .post__title { text-decoration: underline 2px var(--color-signal); text-underline-offset: 5px; }
    }

    @container site (min-width: 600px) {
      .post a { grid-template-columns: 130px minmax(0, 1fr) auto; grid-template-areas: "date title time"; align-items: baseline; padding: 24px 8px; }
    }
    @container site (min-width: 960px) {
      .post a { grid-template-columns: 130px minmax(0, 1fr) auto 16px; grid-template-areas: "date title time arrow"; }
      .post__arrow { display: block; grid-area: arrow; width: 16px; height: 16px; color: var(--color-mist); transition: transform .2s var(--ease-out), color .2s; }
      .post a:hover .post__arrow { transform: translateX(4px); color: var(--color-signal); }
    }
  }
</style>
