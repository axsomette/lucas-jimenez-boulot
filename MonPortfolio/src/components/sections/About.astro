---
/**
 * About — bio, principes de travail et stack technique.
 */
import { Image } from 'astro:assets';
import profile from '@/assets/profile.jpeg';

interface SkillGroup {
  category: string;
  items: string[];
}

interface Principle {
  title: string;
  desc: string;
}

const skills: SkillGroup[] = [
  { category: 'Frontend', items: ['React 19', 'Next.js', 'Astro', 'TypeScript', 'JavaScript', 'HTML', 'SCSS', 'CSS Modules', 'GSAP', 'Vite'] },
  { category: 'Backend et CMS', items: ['PHP 8.3', 'Drupal 11', 'Twig', 'Composer', 'Payload CMS', 'Node.js', 'PostgreSQL', 'MySQL', 'REST API'] },
  { category: 'DevOps et outils', items: ['Git', 'Docker', 'Docker Compose', 'Nginx', 'GitHub Actions', 'GitLab CI', 'CI/CD Pipeline', 'Linux', 'Figma'] },
  { category: 'IA et productivité', items: ['Claude Code', 'Agent Skills', 'Sous-agents', 'MCP', 'Hooks', 'Gemini', 'Cursor', 'Copilot'] },
];

const principles: Principle[] = [
  { title: 'Code maintenable', desc: "J'écris pour celui qui relira le fichier dans deux ans, en supposant qu'il n'aura pas le contexte que j'ai aujourd'hui." },
  { title: 'Performance', desc: 'Je mesure le poids du bundle et le coût des requêtes SQL avant de livrer, pas après la remontée du client.' },
  { title: 'Collaboration', desc: 'Je préfère poser trois questions au cadrage que livrer une fonctionnalité à côté du besoin.' },
];
---

<section id="apropos" class="section" aria-labelledby="apropos-title">
  <div class="container">
    <header class="section-head reveal">
      <p class="kicker">À propos</p>
      <h2 class="title" id="apropos-title">Du code qu'on peut reprendre dans trois ans.</h2>
    </header>

    <div class="about">
      <div>
        <div class="who">
          <Image src={profile} alt="Portrait de Lucas Jimenez Boulot" width={224} height={224} loading="lazy" />
          <div>
            <b>Lucas Jimenez Boulot</b>
            <span>Développeur full-stack, Montpellier</span>
          </div>
        </div>
        <div class="bio">
          <p>
            Je travaille chez <strong>Kaneva</strong> depuis mars 2024. Le plus clair de mon temps part sur du
            <strong>Drupal</strong> et du <strong>PHP</strong> pour des clients d'agence, le reste sur des stacks JavaScript plus récentes.
          </p>
          <p>Je juge un projet réussi quand on peut y revenir trois ans plus tard et le modifier sans crainte.</p>
        </div>
        <ul class="principles" aria-label="Principes de travail">
          {principles.map(p => (
            <li>
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </li>
          ))}
        </ul>
      </div>

      <dl class="stack" aria-label="Stack technique">
        {skills.map(group => (
          <div>
            <dt>{group.category}</dt>
            <dd>{group.items.map(item => <span>{item}</span>)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  @layer components {
    .about { display: grid; gap: 48px; }

    .who { display: flex; align-items: center; gap: 18px; margin-bottom: 28px; }
    .who img {
      flex: none;
      width: 96px;
      height: 96px;
      object-fit: cover;
      object-position: 38% 22%;
      border-radius: var(--radius-corner);
      background: var(--color-ink-2);
    }
    .who b { display: block; font: 700 19px/1.2 var(--font-display); font-stretch: 108%; }
    .who span { display: block; margin-top: 3px; font-size: 15px; color: var(--color-fog); }

    .bio { color: var(--color-fog); }
    .bio p + p { margin-top: 1em; }

    .principles { margin-top: 36px; border-top: 1px solid var(--color-line); }
    .principles li { display: grid; gap: 6px; padding: 20px 0; border-bottom: 1px solid var(--color-line); }
    .principles h3 { font: 650 17px/1.3 var(--font-body); }
    .principles p { font-size: 15.5px; color: var(--color-fog); }

    .stack {
      align-self: start;
      border: 1px solid var(--color-line);
      border-radius: var(--radius-corner);
      background: var(--color-ink-1);
    }
    .stack > div { display: grid; gap: 10px; padding: 22px 24px; }
    .stack > div + div { border-top: 1px solid var(--color-line); }
    .stack dt { font: 500 12px/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--color-mist); }
    /* flex-wrap : chaque techno reste insécable, la liste passe à la ligne entre deux */
    .stack dd { display: flex; flex-wrap: wrap; font-size: 15.5px; line-height: 1.7; }
    .stack dd span { white-space: nowrap; }
    .stack dd span:not(:last-child)::after { content: "·"; margin: 0 .5em; color: var(--color-line-strong); }

    @container site (min-width: 600px) {
      .who img { width: 112px; height: 112px; }
    }
    @container site (min-width: 960px) {
      .about { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 72px; }
    }
  }
</style>
