---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Mark from '../components/ui/Mark.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  publishedTime?: string;
  articleTags?: string[];
  /** Joue l'animation de chargement du logo (accueil uniquement, une fois par session) */
  boot?: boolean;
}

const {
  title = 'Lucas Jimenez Boulot · Développeur Full-Stack à Montpellier',
  description = 'Développeur Full-Stack basé à Montpellier. Je conçois et développe des applications web performantes de bout en bout.',
  ogImage = 'og-image.png',
  ogType = 'website',
  publishedTime,
  articleTags,
  boot = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Compute absolute og:image URL — strip leading slash so new URL() resolves relative to site (which includes base)
const ogImageURL = new URL(ogImage.replace(/^\//, ''), Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fontsURL = 'https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,500..900&family=Instrument+Sans:wght@400..700&family=JetBrains+Mono:wght@400..600&display=swap';
---

<!doctype html>
<html lang="fr" class:list={[{ 'has-boot': boot }]}>
  <head>
    <meta charset="UTF-8" />
    <!--
      Ordre des cascade layers, posé AVANT toute feuille de style : un layer prend son rang à sa première
      apparition, et les styles des composants peuvent être injectés avant global.css. Sans cette ligne,
      @layer components peut passer sous @layer reset et perdre ses marges et paddings.
    -->
    <style is:inline>@layer reset, base, layout, components, utilities;</style>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!--
      Script synchrone — s'exécute AVANT le premier rendu.
      Le chargement du logo ne se joue qu'à la première visite de la session :
      ensuite .boot-seen le masque et retire le délai d'entrée du titre.
      Sans JS (ou sessionStorage bloqué), il se joue à chaque fois, ce qui reste correct.
    -->
    <script is:inline>
      try {
        const root = document.documentElement;
        if (root.classList.contains('has-boot')) {
          if (sessionStorage.getItem('ljb-boot')) root.classList.add('boot-seen');
          else sessionStorage.setItem('ljb-boot', '1');
        }
      } catch (e) {}
    </script>
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0B1020" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="fr_FR" />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && (
      <meta property="article:author" content="Lucas Jimenez Boulot" />
    )}
    {ogType === 'article' && articleTags?.map(tag => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:creator" content="@axsomette" />

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title="Lucas Jimenez Boulot · Blog" href={new URL('rss.xml', Astro.site)} />

    <!-- Icônes — générées depuis brand/ (voir brand/GUIDE.md) -->
    <link rel="icon" href={`${base}/favicon.ico`} sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />

    <!-- Author -->
    <meta name="author" content="Lucas Jimenez Boulot" />

    <!-- Fonts — chargement NON-BLOQUANT (évite la page blanche sur mobile) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!--
      Trick media="print" + onload : le navigateur télécharge la feuille de style
      sans bloquer le rendu (print = basse priorité), puis onload la bascule en "all".
      Sans ça, la police bloque le premier rendu jusqu'à 8s sur mobile lent.
    -->
    <link rel="preload" as="style" href={fontsURL} />
    <link rel="stylesheet" href={fontsURL} media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href={fontsURL} />
    </noscript>

    <!-- JSON-LD — Person -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Lucas Jimenez Boulot",
      "jobTitle": "Développeur Full-Stack",
      "url": String(Astro.site ?? '').replace(/\/$/, ''),
      "email": "lucas@kaneva.io",
      "address": { "@type": "PostalAddress", "addressLocality": "Montpellier", "addressCountry": "FR" },
      "sameAs": [
        "https://github.com/axsomette",
        "https://fr.linkedin.com/in/%F0%9F%92%BB-lucas-jimenez-boulot-35629919b"
      ],
      "knowsAbout": ["Drupal 11", "PHP", "Twig", "Composer", "React", "JavaScript", "TypeScript", "HTML", "SCSS", "CSS", "Vite", "Astro", "Node.js", "SQL", "REST API", "Git", "GitHub Actions", "GitLab CI", "CI/CD", "Linux", "Figma"]
    })} />

    <!-- Slot pour les pages enfants (ex: JSON-LD BlogPosting) -->
    <slot name="head" />

    <!-- JSON-LD — WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Lucas Jimenez Boulot · Portfolio",
      "url": String(Astro.site ?? '').replace(/\/$/, ''),
      "description": description,
      "inLanguage": "fr-FR"
    })} />
  </head>
  <body>
    {boot && (
      <div class="boot" aria-hidden="true">
        <Mark drawable />
      </div>
    )}
    <!-- Hors de .cq : un conteneur de requêtes capture les éléments fixed, le loader doit couvrir l'écran -->
    <div class="cq">
      <a class="skip-link" href="#main-content">Aller au contenu</a>
      <Nav />
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
